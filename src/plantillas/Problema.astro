---
// Plantilla de problema bucal (síntoma que la gente busca: «me sangran las encías», «dolor de muela»…).
// Estudio SEO 2026-11-16 (Yama: «Sí, empieza»): página informativa con fuente que lleva a los tratamientos
// de la clínica. Texto en src/data/contenido/<slug>.json; sin obras sociales ni opiniones (página de lectura).
import Base from '../layouts/Base.astro';
import Secciones from '../components/Secciones.astro';
import Dibujo from '../components/Dibujo.astro';
import mapa from '../data/paginas.json';
import { site, pendiente, enlaceTurno, problemas } from '../lib/datos.js';
import { otrosProblemas } from '../lib/enlazado.js';
import { negrita } from '../lib/texto.js';

const { pagina } = Astro.props;
const c = pagina.contenido;
const fijos = [
  { t: 'Dónde consultar en Santa Fe', bloque: 'mapa' },
  { t: c?.faq_titulo ?? 'Preguntas frecuentes', bloque: 'faq' },
];
const relacionados = (c?.relacionados ?? [])
  .map((s) => mapa.paginas.find((p) => p.slug === s && p.estado === 'si'))
  .filter(Boolean);
const autor = c?.autor && site.profesionales.find((p) => p.nombre === c.autor);
// Enlazado entre síntomas (enlazado.js): primero los más cercanos, luego el resto.
const otros = otrosProblemas(pagina.slug).map((s) => problemas.find((p) => p.slug === s)).filter(Boolean);
---
<Base pagina={pagina}>
  <div class="contenedor">
    <nav class="migas" aria-label="Migas">
      <a href="/">Clínica dental</a> › <a href="/problemas-bucales/">Problemas bucales</a> › {pagina.nombre}
    </nav>
    <section class="heroe heroe-tratamiento">
      <div>
      <h1>{pagina.h1}</h1>
      <p class="entrada" set:html={negrita(c?.intro ?? pagina.description)} />
      <div class="botones">
        <a class="boton" href={enlaceTurno(site.sedes[0])}>Pedir turno</a>
        <a class="boton secundario" href="/problemas-bucales/">Otros problemas bucales</a>
      </div>
      </div>
      <div class="dibujo-grande"><Dibujo slug={c?.dibujo ?? ''} tam={180} /></div>
    </section>
    {c?.resumen?.length > 0 && (
      <aside class="resumen" aria-label={`En resumen: ${pagina.nombre}`}>
        <p class="resumen-titulo">En resumen</p>
        <ul>{c.resumen.map((x) => <li>{x}</li>)}</ul>
      </aside>
    )}
    <Secciones pagina={pagina} />
    {relacionados.length > 0 && (
      <nav class="relacionados" aria-label="Tratamientos relacionados">
        <p class="relacionados-titulo">Tratamientos relacionados</p>
        <ul>{relacionados.map((p) => <li><a href={`/${p.slug}/`}>{p.nombre.replace(/\s*\(.*?\)/, '')} →</a></li>)}</ul>
      </nav>
    )}
    <Secciones pagina={pagina} h2s={fijos} />
    {otros.length > 0 && (
      <nav class="relacionados" aria-label="Otros problemas bucales">
        <p class="relacionados-titulo">Otros problemas bucales</p>
        <ul>{otros.map((p) => <li><a href={`/${p.slug}/`}>{p.nombre} →</a></li>)}</ul>
      </nav>
    )}
    {c && (
      <aside class="ficha-autor" aria-label="Revisión del contenido">
        <p>
          <strong>Revisado por:</strong>
          {autor ? `${autor.nombre} · Matrícula ${autor.matricula}` : pendiente('odontólogo que revisa, con matrícula')}
          <br /><strong>Fecha de revisión:</strong> {c.revisado ?? pendiente('fecha de revisión')}
        </p>
        <p>Esta información es general y no reemplaza una consulta con un odontólogo. Ante una urgencia, acudir a una guardia o a emergencias.</p>
      </aside>
    )}
  </div>
</Base>
