---
import Base from '../layouts/Base.astro';
import Secciones from '../components/Secciones.astro';
import { sedePorId, enlaceTurno } from '../lib/datos.js';

const { pagina } = Astro.props;
const sede = sedePorId(pagina.sede);
---
<Base pagina={pagina}>
  <div class="contenedor">
    <nav class="migas" aria-label="Migas"><a href="/">Inicio</a> › {sede.ciudad}</nav>
    <section class="heroe">
      <h1>{pagina.h1}</h1>
      <div class="datos-sede"><span>{sede.direccion}</span><span>{sede.telefono}</span><span>{sede.horario}</span></div>
      <div class="botones"><a class="boton" href={enlaceTurno(sede)}>Pedir turno en {sede.ciudad}</a></div>
    </section>
    <Secciones pagina={pagina} />
  </div>
</Base>
