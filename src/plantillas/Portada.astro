---
// Portada con la estructura de la referencia (COV): héroe con foto, primera consulta
// destacada y 4 ventajas; luego los H2 de paginas.json con su bloque de datos.
import Base from '../layouts/Base.astro';
import Secciones from '../components/Secciones.astro';
import { site, enlaceTurno, pendiente, foto } from '../lib/datos.js';

const { pagina } = Astro.props;
const [linea1, linea2] = pagina.h1.split(/ (?=en )/);
const sede = site.sedes[0];
const heroe = foto('heroe');
---
<Base pagina={pagina} precarga={heroe?.src}>
  <section class:list={['heroe', { 'heroe-foto': heroe }]} style={heroe ? `--foto:url('${heroe.src}')` : undefined} role="img" aria-label={heroe?.alt}>
    <div class="contenedor">
      <div class="heroe-texto">
        <h1>{linea1} <span>{linea2}</span></h1>
        <p class="entrada">{pagina.contenido?.entrada ?? pendiente('frase de presentación (Fase 3)')}</p>
        <p class="destacado">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>
          <span>{site.primera_consulta}</span>
        </p>
        <div class="botones">
          <a class="boton" href={enlaceTurno(sede)}>Pedir turno →</a>
          <a class="boton secundario" href="/tratamientos/">Ver tratamientos</a>
        </div>
      </div>
      <ul class="ventajas">
        {site.ventajas.map((v) => (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            {v}
          </li>
        ))}
      </ul>
      {!site.confirmado && <p class="pendiente">{pendiente('confirmar que la primera consulta y estas 4 ventajas son ciertas')}</p>}
    </div>
  </section>
  <div class="contenedor">
    <Secciones pagina={pagina} />
  </div>
</Base>
