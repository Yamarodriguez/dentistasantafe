---
// Pinta los H2 de paginas.json. Cada H2 puede ser:
//   "texto"                       → sección de texto (se redacta en Fase 3)
//   { t, bloque }                 → se rellena con datos (Bloque.astro)
//   { t, foto: "consulta" }       → foto de site.json > fotos al lado del texto
//   (o contenido/<slug>.json > fotos: { "H2": "clave" }); las fotos se alternan izquierda/derecha
//   { t, boton: { t, href } }     → botón al final
//   { t, bloque, opcional: true } → si no hay datos reales, la sección no sale
// {nombre} en el título se cambia por el nombre de la clínica.
import Bloque from './Bloque.astro';
import Texto from './Texto.astro';
import { site, pendiente, foto as fotoDe } from '../lib/datos.js';

const { pagina, h2s = pagina.h2s } = Astro.props;
const norm = (h) => (typeof h === 'string' ? { t: h } : h);
const conDatos = { promociones: site.promociones, reconocimientos: site.reconocimientos, marcas: site.marcas };
const visibles = h2s.map(norm).filter((h) => !h.opcional || (conDatos[h.bloque] ?? []).length);
const titulo = (h) => h.t.replace('{nombre}', site.nombre).replace(/Santa Fe/g, 'Santa Fe'); // «Santa Fe» nunca se parte en dos líneas
const id = (h) => (h.bloque === 'faq' ? 'preguntas-frecuentes' : undefined);
const banda = (h) => ['tratamientos', 'opiniones', 'promociones'].includes(h.bloque) && pagina.tipo === 'portada';
const foto = (h) => fotoDe(h.foto ?? pagina.contenido?.fotos?.[h.t]);
// disposicion: "foto-abajo" → título arriba y, debajo, la foto a un lado y el bloque (p. ej. los H3) al otro.
// En «porque», los 2 últimos motivos van arriba, a la derecha del título (parte="arriba").
const abajo = (h) => h.disposicion === 'foto-abajo' && foto(h);
// En «Nuestros dentistas», la frase va a la derecha del título (arriba de la ficha), para que quede encuadrado.
const textoAlLado = (h) => h.bloque === 'equipo' && textos[h.t];
const lado = new Map(visibles.filter((h) => foto(h) && !abajo(h)).map((h, i) => [h.t, i % 2 ? 'derecha' : 'izquierda']));
const textos = pagina.contenido?.secciones ?? {};
// Antetítulo: rota entre «clínica dental», «dentista» y «centro odontológico» (fijo por H2).
const variantes = site.antetitulos ?? [site.antetitulo];
// Nunca repite la palabra clave que ya lleva el título (p. ej. «Clínica dental…» sobre un H2 con «clínica dental»).
const ante = (h) => {
  const ini = [...h.t].reduce((a, ch) => a + ch.charCodeAt(0), 0) % variantes.length;
  const t = titulo(h).toLowerCase();
  for (let i = 0; i < variantes.length; i++) {
    const v = variantes[(ini + i) % variantes.length];
    if (!t.includes(v.toLowerCase().replace(/ en santa fe$/, '').replace(/s$/, ''))) return v;
  }
  return variantes[ini];
};
---
{visibles.map((h) => abajo(h) ? (
  <section class:list={['seccion', `bloque-${h.bloque ?? 'texto'}`, 'foto-abajo', { banda: banda(h) }]} id={id(h)}>
    <div class:list={['cabeza-abajo', { 'con-arriba': h.bloque === 'porque' || textoAlLado(h) }]}>
      <div class="seccion-cuerpo">
        <p class="antetitulo">{ante(h)}</p>
        <h2>{titulo(h)}</h2>
        {h.bloque && textos[h.t] && !textoAlLado(h) && <Texto bloques={textos[h.t]} />}
      </div>
      {textoAlLado(h) && <div class="texto-al-lado"><Texto bloques={textos[h.t]} /></div>}
      {h.bloque === 'porque' && <div class="fila-bloque arriba"><Bloque tipo={h.bloque} pagina={pagina} parte="arriba" /></div>}
    </div>
    <div class="fila-foto">
      <img class="foto-seccion" src={foto(h).src} alt={foto(h).alt} width="900" height="1125" loading="lazy" decoding="async" />
      <div class="fila-bloque">
        {h.bloque
          ? <Bloque tipo={h.bloque} pagina={pagina} parte={h.bloque === 'porque' ? 'abajo' : undefined} />
          : textos[h.t] ? <Texto bloques={textos[h.t]} /> : <p class="pendiente">{pendiente('texto (Fase 3)')}</p>}
        {!h.bloque && h.boton && <div class="botones"><a class="boton" href={h.boton.href}>{h.boton.t} →</a></div>}
      </div>
    </div>
    {h.bloque && h.boton && <div class="botones"><a class="boton" href={h.boton.href}>{h.boton.t} →</a></div>}
  </section>
) : (
  <section
    class:list={['seccion', `bloque-${h.bloque ?? 'texto'}`, { banda: banda(h), 'con-foto': foto(h) }, lado.get(h.t)]}
    id={id(h)}
  >
    {foto(h) && (
      <img class="foto-seccion" src={foto(h).src} alt={foto(h).alt} width="900" height="1125" loading="lazy" decoding="async" />
    )}
    <div class="seccion-cuerpo">
      <p class="antetitulo">{ante(h)}</p>
      <h2>{titulo(h)}</h2>
      {textos[h.t] && <Texto bloques={textos[h.t]} />}
      {h.bloque
        ? <Bloque tipo={h.bloque} pagina={pagina} />
        : !textos[h.t] && <p class="pendiente">{pendiente('texto (Fase 3)')}</p>}
      {h.boton && <div class="botones"><a class="boton" href={h.boton.href}>{h.boton.t} →</a></div>}
    </div>
  </section>
))}
