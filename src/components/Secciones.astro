---
// Pinta los H2 de paginas.json. Cada H2 puede ser:
//   "texto"                       → sección de texto (se redacta en Fase 3)
//   { t, bloque }                 → se rellena con datos (Bloque.astro)
//   { t, foto: "consulta" }       → foto de site.json > fotos al lado del texto
//   { t, boton: { t, href } }     → botón al final
//   { t, bloque, opcional: true } → si no hay datos reales, la sección no sale
// {nombre} en el título se cambia por el nombre de la clínica.
import Bloque from './Bloque.astro';
import Texto from './Texto.astro';
import { site, pendiente, foto as fotoDe } from '../lib/datos.js';

const { pagina, h2s = pagina.h2s } = Astro.props;
const norm = (h) => (typeof h === 'string' ? { t: h } : h);
const conDatos = { promociones: site.promociones, reconocimientos: site.reconocimientos, marcas: site.marcas };
const visibles = h2s.map(norm).filter((h) => !h.opcional || (conDatos[h.bloque] ?? []).length);
const titulo = (h) => h.t.replace('{nombre}', site.nombre);
const id = (h) => (h.bloque === 'faq' ? 'preguntas-frecuentes' : undefined);
const banda = (h) => ['tratamientos', 'opiniones', 'promociones'].includes(h.bloque) && pagina.tipo === 'portada';
const foto = (h) => h.foto && fotoDe(h.foto);
const textos = pagina.contenido?.secciones ?? {};
// Antetítulo: rota entre «clínica dental», «dentista» y «centro odontológico» (fijo por H2).
const variantes = site.antetitulos ?? [site.antetitulo];
const ante = (h) => variantes[[...h.t].reduce((a, ch) => a + ch.charCodeAt(0), 0) % variantes.length];
---
{visibles.map((h) => (
  <section
    class:list={['seccion', `bloque-${h.bloque ?? 'texto'}`, { banda: banda(h), 'con-foto': foto(h) }]}
    id={id(h)}
  >
    {foto(h) && (
      <img class="foto-seccion" src={foto(h)} alt={`${site.nombre}: ${titulo(h)}`} width="800" height="1067" loading="lazy" />
    )}
    <div class="seccion-cuerpo">
      <p class="antetitulo">{ante(h)}</p>
      <h2>{titulo(h)}</h2>
      {textos[h.t] && <Texto bloques={textos[h.t]} />}
      {h.bloque
        ? <Bloque tipo={h.bloque} pagina={pagina} />
        : !textos[h.t] && <p class="pendiente">{pendiente('texto (Fase 3)')}</p>}
      {h.boton && <div class="botones"><a class="boton" href={h.boton.href}>{h.boton.t} →</a></div>}
    </div>
  </section>
))}
