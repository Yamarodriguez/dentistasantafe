---
// Rellena una sección con datos de site.json / paginas.json.
// Si falta el dato, pone [Pendiente: …] (nunca se inventa nada).
import { site, ruta, tratamientos, enlaceTurno, pendiente, grupos } from '../lib/datos.js';
import Formulario from './Formulario.astro';
import Dibujo from './Dibujo.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const { tipo, pagina } = Astro.props;
const sedes = pagina.sede ? site.sedes.filter((s) => s.id === pagina.sede) : site.sedes;
const profesionales = site.profesionales.filter(
  (p) => !pagina.sede || p.sedes.includes(pagina.sede)
);
const opiniones = site.opiniones.filter((o) => !pagina.sede || o.sede === pagina.sede);
// Icono de cada motivo de «¿Por qué elegir…?» según su título (como la referencia)
const ICONOS_MOTIVO = {
  especialista: '<circle cx="12" cy="7.5" r="3.5"/><path d="M5 20.5c.6-3.6 3.4-6 7-6s6.4 2.4 7 6"/><path d="M12 14.5v3.2"/><circle cx="12" cy="19" r="1.2"/>',
  años: '<circle cx="12" cy="9" r="5.5"/><path d="M12 6.4l1 2 2.2.3-1.6 1.5.4 2.2-2-1-2 1 .4-2.2-1.6-1.5 2.2-.3z"/><path d="M8.6 13.5 7.5 21l4.5-2.4 4.5 2.4-1.1-7.5"/>',
  tecnolog: '<rect x="3" y="4" width="18" height="12.5" rx="1.8"/><path d="M8.5 20.5h7M12 16.5v4"/><path d="M7 12.5l3-3 2.5 2 4.5-4.5"/>',
  financ: '<rect x="2.8" y="5.5" width="18.4" height="13" rx="2"/><path d="M2.8 10h18.4"/><path d="M6.5 14.8h4M14.5 14.8h3"/>',
};
const iconoMotivo = (titulo = '') => {
  const k = Object.keys(ICONOS_MOTIVO).find((c) => titulo.toLowerCase().includes(c));
  return k ? ICONOS_MOTIVO[k] : '<path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z"/>';
};
---
{tipo === 'sedes' && (
  <div class="tarjetas">
    {sedes.map((s) => (
      <article class="tarjeta">
        <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
        <h3><a href="/contacto/">{s.ciudad}</a></h3>
        <p>{s.barrio}<br />{s.direccion}<br />{s.horario}</p>
        <a class="mas" href={enlaceTurno(s)}>Pedir turno →</a>
      </article>
    ))}
  </div>
)}

{tipo === 'tratamientos' && pagina.tipo === 'indice' && grupos.map((g) => (
  <>
    <h3>{g}</h3>
    <div class="tarjetas">
      {tratamientos.filter((t) => t.grupo === g).map((t) => (
        <article class="tarjeta">
          <Dibujo slug={t.slug} tam={64} />
          <h4><a href={ruta(t.slug)}>{t.nombre}</a></h4>
          <p>{t.description}</p>
          <a class="mas" href={ruta(t.slug)} aria-label={`Más sobre ${t.nombre}`}>Ver tratamiento →</a>
        </article>
      ))}
    </div>
  </>
))}

{tipo === 'contacto' && sedes.map((s) => (
  <div class="contacto">
    <div>
      <p><strong>{site.nombre}</strong><br />{s.direccion} · {s.barrio}, {s.ciudad}</p>
      <p>Teléfono: {s.telefono}<br />Horario: {s.horario}</p>
    </div>
    <div class="botones">
      <a class="boton" href={enlaceTurno(s)}>Turno por WhatsApp →</a>
      {s.mapa && <a class="boton secundario" href={s.mapa}>Cómo llegar</a>}
    </div>
    {!s.whatsapp && <p class="pendiente">{pendiente('número de WhatsApp')}</p>}
    <div class="ancho-completo"><Formulario /></div>
  </div>
))}

{tipo === 'porque' && (
  <>
    {!site.confirmado && <p class="pendiente">{pendiente('confirmar que estos 4 motivos son ciertos')}</p>}
    <div class="tarjetas cuatro">
      {(site.porque.length ? site.porque : [1, 2, 3, 4].map((n) => ({ titulo: pendiente(`motivo ${n}`), texto: '' }))).map((m) => (
        <article class="tarjeta centrada motivo">
          <span class="motivo-icono" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconoMotivo(m.titulo)} />
          </span>
          <h3>{m.titulo}</h3>
          {m.texto && <p>{m.texto}</p>}
        </article>
      ))}
    </div>
  </>
)}

{tipo === 'promociones' && (
  <div class="categorias">
    {site.promociones.map((p) => (
      <article class="categoria promo">
        <p class="antetitulo">Promoción · hasta {p.vigencia}</p>
        <h3>{p.titulo}</h3>
        <p>{p.texto}</p>
        <p class="precio">{p.precio}</p>
        <a class="boton" href={p.href}>Más información →</a>
      </article>
    ))}
  </div>
)}

{tipo === 'reconocimientos' && (
  <ul>{site.reconocimientos.map((r) => <li>{r}</li>)}</ul>
)}

{tipo === 'marcas' && (
  <ul class="marcas">{site.marcas.map((m) => <li>{m}</li>)}</ul>
)}

{tipo === 'tratamientos' && pagina.tipo === 'portada' && (
  <div class="grupos-servicios">
    {grupos.map((g) => (
      <div class="grupo-caja">
        <h3 class="grupo-titulo">{g}</h3>
        <ul>
          {tratamientos.filter((t) => t.grupo === g).map((t) => (
            <li>
              <a class="servicio-fila" href={ruta(t.slug)}>
                <span class="servicio-dibujo"><Dibujo slug={t.slug} tam={46} /></span>
                <h4 class="servicio-nombre">{t.nombre}</h4>
                <span class="flecha" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
)}

{tipo === 'tratamientos' && pagina.tipo !== 'indice' && pagina.tipo !== 'portada' && (
  <div class="tarjetas">
    {tratamientos.map((t) => (
      <article class="tarjeta">
        <Dibujo slug={t.slug} tam={64} />
        <h3><a href={ruta(t.slug)}>{t.nombre}</a></h3>
        <p>{t.description}</p>
        <a class="mas" href={ruta(t.slug)} aria-label={`Más sobre ${t.nombre}`}>Ver tratamiento →</a>
      </article>
    ))}
  </div>
)}

{tipo === 'obras' && sedes.map((s) => {
  const lista = s.obrasSociales.filter((o) => !o.startsWith('['));
  const notas = s.obrasSociales.filter((o) => o.startsWith('['));
  return lista.length ? (
    <>
      <ul class="obras">
        {lista.map((o) => (
          <li class="obra">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
            <span>{o}</span>
          </li>
        ))}
      </ul>
      {notas.map((n) => <p class="pendiente">{n}</p>)}
    </>
  ) : <p class="pendiente">{pendiente(`obras sociales y prepagas de ${s.ciudad}`)}</p>;
})}
{tipo === 'creditos' && (
  <>
    <p>Las fotos de ambiente de esta web son de <a href="https://unsplash.com" rel="noopener">Unsplash</a> (licencia Unsplash) y no muestran a pacientes de la clínica.</p>
    <ul>
      {(site.creditos_fotos ?? []).map((c) => <li>{c.foto}: <a href={c.url} rel="noopener">{c.autor}</a></li>)}
    </ul>
  </>
)}

{tipo === 'obras' && pagina.slug !== 'obras-sociales' && (
  <p class="mas-info"><a href="/obras-sociales/">Qué cubre cada obra social y qué llevar al turno →</a></p>
)}

{tipo === 'equipo' && (profesionales.length
  ? (
    <div class="tarjetas">
      {profesionales.map((p) => (
        <article class="tarjeta">
          {p.foto && existsSync(join(process.cwd(), "public", p.foto)) && <img class="foto-profesional" src={p.foto} alt={`Foto de ${p.nombre}`} width="900" height="1125" loading="lazy" />}
          <h3>{p.nombre}</h3>
          <p>{p.especialidad} · Matrícula {p.matricula}</p>
        </article>
      ))}
    </div>
  )
  : <p class="pendiente">{pendiente('profesionales con título, matrícula, especialidad y sede')}</p>)}

{tipo === 'opiniones' && (opiniones.length
  ? (
    <div class="tarjetas">
      {opiniones.map((o) => (
        <blockquote class="tarjeta opinion">
          {o.estrellas && <p class="estrellas" aria-label={`${o.estrellas} de 5 estrellas`}>{'★'.repeat(o.estrellas)}</p>}
          <p>{o.texto}</p>
          <footer>{o.autor} · {o.fuente}</footer>
        </blockquote>
      ))}
    </div>
  )
  : <p class="pendiente">{pendiente('reseñas reales de Google con nombre')}</p>)}

{tipo === 'faq' && (pagina.faq.length
  ? pagina.faq.map((f) => (
      <details>
        <summary><h3>{f.q}</h3></summary>
        <p>{f.a}</p>
      </details>
    ))
  : <p class="pendiente">{pendiente('preguntas frecuentes (Fase 3)')}</p>)}

{tipo === 'mapa' && sedes.map((s) => (
  <>
    <p>{s.direccion} ({s.barrio}, {s.ciudad}) {s.mapa ? <a href={s.mapa}>Ver en Google Maps</a> : <span class="pendiente">{pendiente('enlace a Google Maps')}</span>}</p>
    {pagina.tipo === 'portada' && <p><strong>Horario:</strong> {s.horario}</p>}
  </>
))}

{tipo === 'horario' && sedes.map((s) => (
  <p>{s.ciudad}: {s.horario}</p>
))}

{tipo === 'turno' && (
  <div class="botones">
    {sedes.map((s) => (
      <a class="boton" href={enlaceTurno(s)}>Pedir turno por WhatsApp</a>
    ))}
  </div>
)}
