---
// Dibujos propios de cada tratamiento (SVG de línea, colores del tema).
// Uso: <Dibujo slug="implantes-dentales-santa-fe" tam={96} />
const { slug = '', tam = 96, clase = '' } = Astro.props;

// Diente base (viewBox 0 0 96 96)
const DIENTE = 'M31 14c-9 0-16 7-16 17 0 9 4 16 6 25 2 11 4 26 11 26 6 0 6-14 10-19 2-3 7-3 9 0 4 5 4 19 10 19 7 0 9-15 11-26 2-9 6-16 6-25 0-10-7-17-16-17-7 0-10 4-16 4s-9-4-15-4z';
const tipo = Object.entries({
  implante: 'implantes', protesis: 'protesis', invisible: 'invisible', ortodoncia: 'ortodoncia',
  conducto: 'conducto', periodoncia: 'periodoncia', estetica: 'estetica', limpieza: 'limpieza',
  odontopediatr: 'ninos', guardia: 'guardia',
}).find(([k]) => slug.includes(k))?.[1] ?? 'diente';
---
<svg class:list={['dibujo', clase]} width={tam} height={tam} viewBox="0 0 96 96" fill="none"
  stroke="var(--accion)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {tipo === 'implantes' && (
    <>
      <path d="M26 12c-7 0-12 5-12 12 0 5 2 9 4 12h60c2-3 4-7 4-12 0-7-5-12-12-12-6 0-9 3-14 3s-9-3-14-3z" fill="var(--tinte-1)" />
      <path d="M40 36h16v8H40z" fill="var(--superficie)" />
      <path d="M42 44h12l-2 40h-8z" fill="var(--tinte-2)" />
      <path d="M40 52l16-3M40 60l16-3M41 68l14-3M42 76l12-3" />
      <path d="M8 86h80" stroke="var(--acento)" />
    </>
  )}
  {tipo === 'protesis' && (
    <>
      <path d={DIENTE} />
      <path d="M31 14c-9 0-16 7-16 17 0 6 2 11 4 16h58c2-5 4-10 4-16 0-10-7-17-16-17-7 0-10 4-16 4s-9-4-15-4z" fill="var(--tinte-1)" />
      <path d="M19 47h58" stroke="var(--acento)" stroke-width="3" />
    </>
  )}
  {tipo === 'ortodoncia' && (
    <>
      <path d="M8 30c4-10 26-10 30 0v32c0 10-30 10-30 0z" fill="var(--superficie)" />
      <path d="M58 30c4-10 26-10 30 0v32c0 10-30 10-30 0z" fill="var(--superficie)" />
      <path d="M33 30c4-10 26-10 30 0v32c0 10-30 10-30 0z" fill="var(--tinte-1)" />
      <rect x="16" y="40" width="14" height="12" rx="2" fill="var(--superficie)" />
      <rect x="41" y="40" width="14" height="12" rx="2" fill="var(--superficie)" />
      <rect x="66" y="40" width="14" height="12" rx="2" fill="var(--superficie)" />
      <path d="M4 46h88" stroke="var(--acento)" stroke-width="3" />
    </>
  )}
  {tipo === 'invisible' && (
    <>
      <path d={DIENTE} fill="var(--tinte-1)" />
      <path d="M31 8c-12 0-21 9-21 22 0 9 3 15 5 21" stroke-dasharray="4 5" stroke="var(--acento)" />
      <path d="M65 8c12 0 21 9 21 22 0 9-3 15-5 21" stroke-dasharray="4 5" stroke="var(--acento)" />
      <path d="M31 8c8 0 11 4 17 4s9-4 17-4" stroke-dasharray="4 5" stroke="var(--acento)" />
      <path d="M70 24l3-3M75 30l4-1" stroke="var(--acento)" />
    </>
  )}
  {tipo === 'conducto' && (
    <>
      <path d={DIENTE} fill="var(--superficie)" />
      <path d="M36 26c4 6 10 6 12 3 2 3 8 3 12-3" fill="var(--tinte-2)" />
      <path d="M40 30c0 14-3 30-6 46M56 30c0 14 3 30 6 46" stroke="var(--acento)" stroke-width="3" />
    </>
  )}
  {tipo === 'periodoncia' && (
    <>
      <path d={DIENTE} fill="var(--superficie)" />
      <path d="M6 56c8-8 14-8 22-2s14 6 20 0 12-6 20 0 14 6 22 2v30H6z" fill="var(--tinte-3)" />
      <path d="M6 56c8-8 14-8 22-2s14 6 20 0 12-6 20 0 14 6 22 2" stroke="var(--acento)" />
    </>
  )}
  {tipo === 'estetica' && (
    <>
      <path d={DIENTE} fill="var(--tinte-1)" />
      <path d="M78 6v12M72 12h12" stroke="var(--acento)" />
      <path d="M86 26v6M83 29h6" stroke="var(--acento)" />
      <path d="M34 26c4-4 8-5 12-4" stroke="var(--superficie)" stroke-width="4" />
    </>
  )}
  {tipo === 'limpieza' && (
    <>
      <path d={DIENTE} fill="var(--superficie)" transform="translate(-10 4) scale(.85)" />
      <path d="M58 86l30-48" stroke-width="5" />
      <path d="M80 32l12 8M84 26l12 8M88 20l10 7" stroke="var(--acento)" />
      <circle cx="20" cy="16" r="4" stroke="var(--acento)" />
      <circle cx="12" cy="28" r="2.5" stroke="var(--acento)" />
    </>
  )}
  {tipo === 'ninos' && (
    <>
      <path d={DIENTE} fill="var(--tinte-1)" transform="translate(10 12) scale(.8)" />
      <circle cx="38" cy="40" r="2.5" fill="var(--accion)" stroke="none" />
      <circle cx="58" cy="40" r="2.5" fill="var(--accion)" stroke="none" />
      <path d="M38 50c5 6 15 6 20 0" />
      <path d="M14 14l4 4M10 26h6M80 10l-4 5" stroke="var(--acento)" />
    </>
  )}
  {(tipo === 'diente' || tipo === 'guardia') && <path d={DIENTE} fill="var(--tinte-1)" />}
</svg>
