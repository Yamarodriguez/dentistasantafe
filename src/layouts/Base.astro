---
// Esqueleto común: <head> SEO, letras, tema de color, cabecera, franja de turno, pie.
import '@fontsource/playfair-display/latin-600.css';
import '@fontsource/playfair-display/latin-ext-600.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-ext-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-ext-600.css';
import '../styles/base.css';
import temas from '../data/temas.json';
import { site, ruta, enlaceTurno } from '../lib/datos.js';
import { schemaDe } from '../lib/schema.js';

const { pagina } = Astro.props;
const canonical = pagina.tipo === '404' ? null : new URL(ruta(pagina.slug), site.url).href;
const { precarga } = Astro.props; // imagen grande de arriba (sin lazy, se precarga)
const ld = pagina.tipo === '404' ? null : schemaDe(pagina);

// TEMA=dorado npm run build → solo para comparar direcciones; la elegida va en site.json.
const idTema = process.env.TEMA || site.tema;
const t = temas[idTema];
const vars = [
  `--fondo:${t.fondo}`, `--superficie:${t.superficie}`, `--banda:${t.banda}`,
  `--texto:${t.texto_color}`, `--suave:${t.suave}`, `--accion:${t.accion}`,
  `--accion-texto:${t.accion_texto}`, `--acento:${t.acento}`, `--borde:${t.borde}`,
  `--oscuro:${t.oscuro}`, `--oscuro-texto:${t.oscuro_texto}`, `--radio:${t.radio}`,
  ...t.tintes.map((c, i) => `--tinte-${i + 1}:${c}`),
  `--f-titulos:'${t.titulos}'`, `--f-tarjeta:'${t.tarjeta}'`, `--f-texto:'${t.texto}'`,
].join(';');
---
<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pagina.title}</title>
    <meta name="description" content={pagina.description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {(!site.indexar || pagina.tipo === '404') && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={t.oscuro} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={pagina.title} />
    <meta property="og:description" content={pagina.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL(site.logo, site.url).href} />
    <link rel="icon" href={site.logo} />
    {precarga && <link rel="preload" as="image" href={precarga} fetchpriority="high" />}
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body class="web" data-tema={idTema} style={vars}>
    <header class="cabecera">
      <div class="contenedor">
        <a class="marca" href="/">
          <img src={site.logo_web} alt={`Logo de ${site.nombre}`} width="44" height="44" />
          <span>{site.nombre}</span>
        </a>
        <nav class="menu" aria-label="Principal">
          <a href="/tratamientos/">Tratamientos</a>
          <a href="/obras-sociales/">Obras sociales</a>
          <a href="/equipo/">Equipo</a>
          <a href="/contacto/">Contacto</a>
          <a class="boton" href="/contacto/">Pedir turno</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    {pagina.tipo !== '404' && pagina.tipo !== 'turnos' && pagina.tipo !== 'portada' && (
      <aside class="franja-turno" aria-label="Turnos">
        <div class="contenedor">
          <div>
            <p class="antetitulo">{site.antetitulo}</p>
            <p class="titulo-franja">Turnos en Santa Fe</p>
            <p>Por WhatsApp, por teléfono o con el formulario de contacto.</p>
          </div>
          <div class="botones">
            {site.sedes.map((s) => <a class="boton" href={enlaceTurno(s)}>Pedir turno →</a>)}
          </div>
        </div>
      </aside>
    )}

    <footer class="pie">
      <div class="contenedor">
        {site.sedes.map((s) => (
          <div>
            <p class="pie-titulo"><a href="/contacto/">{site.nombre} · {s.ciudad}</a></p>
            <p>{s.direccion}<br />{s.telefono}<br />{s.horario}</p>
          </div>
        ))}
        <div>
          <p class="pie-titulo">{site.nombre}</p>
          <p>
            <a href="/tratamientos/">Tratamientos</a><br />
            <a href="/obras-sociales/">Obras sociales</a><br />
            <a href="/equipo/">Equipo</a>
          </p>
        </div>
      </div>
      <div class="contenedor pie-legal">
        <img src={site.logo_web} alt="" role="presentation" width="40" height="40" loading="lazy" />
        <p><a href="/privacidad/">Privacidad</a> · <a href="/terminos/">Términos</a></p>
      </div>
    </footer>

    <a class="boton boton-turno" href="/contacto/">Pedir turno</a>
  </body>
</html>
