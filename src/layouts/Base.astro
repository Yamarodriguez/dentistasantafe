---
// Esqueleto común: <head> SEO, letras, tema de color, cabecera, franja de turno, pie.
import '@fontsource/open-sans/latin-400.css';
import '@fontsource/open-sans/latin-ext-400.css';
import '@fontsource/open-sans/latin-600.css';
import '@fontsource/open-sans/latin-ext-600.css';
import '@fontsource/open-sans/latin-700.css';
import '@fontsource/open-sans/latin-ext-700.css';
import '@fontsource/playfair-display/latin-600.css';
import '@fontsource/playfair-display/latin-ext-600.css';
import '../styles/base.css';
import temas from '../data/temas.json';
import { site, ruta, enlaceTurno, tratamientos, foto, telefonoDe, etiquetaTelefono } from '../lib/datos.js';
import { schemaDe } from '../lib/schema.js';

// Menú como la referencia: tratamientos principales sueltos, el resto en «Otros tratamientos»
const MENU_ORTODONCIA = ['ortodoncia-santa-fe', 'ortodoncia-invisible-santa-fe'];
// Mismo nombre en menú y pie (análisis SEO 2026-11-15).
const ETIQUETA_MENU = {};
const etiqueta = (t) => ETIQUETA_MENU[t.slug] ?? t.nombre.replace(/\s*\(.*?\)/, '');
const MENU_ESTETICA = ['carillas-dentales-santa-fe', 'blanqueamiento-dental-santa-fe'];
const MENU_SUELTOS = ['implantes-dentales-santa-fe', ...MENU_ESTETICA, ...MENU_ORTODONCIA];

const { pagina } = Astro.props;
const canonical = pagina.tipo === '404' ? null : new URL(ruta(pagina.slug), site.url).href;
const { precarga } = Astro.props; // imagen grande de arriba (sin lazy, se precarga)
const ld = pagina.tipo === '404' ? null : schemaDe(pagina);
// Imagen al compartir (WhatsApp, redes, buscadores): la foto del primer H2 del tratamiento;
// en la portada, la del consultorio; si no, la primera foto de sus H2 (paginas.json); y si no hay, el logo.
const fotoH2 = (pagina.h2s ?? []).find((h) => typeof h === 'object' && h.foto && foto(h.foto))?.foto;
const claveFoto = pagina.slug ? Object.values(pagina.contenido?.fotos ?? {})[0] ?? fotoH2 : 'consulta';
const imagenCompartir = (claveFoto && foto(claveFoto)?.src) || site.logo;

// TEMA=dorado npm run build → solo para comparar direcciones; la elegida va en site.json.
const idTema = process.env.TEMA || site.tema;
const t = temas[idTema];
const vars = [
  `--fondo:${t.fondo}`, `--superficie:${t.superficie}`, `--banda:${t.banda}`,
  `--texto:${t.texto_color}`, `--suave:${t.suave}`, `--accion:${t.accion}`,
  `--accion-texto:${t.accion_texto}`, `--acento:${t.acento}`, `--borde:${t.borde}`,
  `--oscuro:${t.oscuro}`, `--oscuro-texto:${t.oscuro_texto}`, `--radio:${t.radio}`,
  ...t.tintes.map((c, i) => `--tinte-${i + 1}:${c}`),
  `--f-titulos:'${t.titulos}'`, `--f-tarjeta:'${t.tarjeta}'`, `--f-texto:'${t.texto}'`,
].join(';');
---
<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="utf-8" />
    <!-- Google Tag Manager (GTM-N4MJ69PR) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-N4MJ69PR"></script>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pagina.title}</title>
    <meta name="description" content={pagina.description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {(!site.indexar || pagina.tipo === '404') && <meta name="robots" content="noindex, nofollow" />}
    {site.indexar && pagina.tipo === 'legal' && <meta name="robots" content="noindex, follow" />}
    {site.google_verificacion && <meta name="google-site-verification" content={site.google_verificacion} />}
    {site.bing_verificacion && <meta name="msvalidate.01" content={site.bing_verificacion} />}
    <meta name="theme-color" content={t.oscuro} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={pagina.title} />
    <meta property="og:description" content={pagina.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL(imagenCompartir, site.url).href} />
    {imagenCompartir !== site.logo && <meta name="twitter:card" content="summary_large_image" />}
    <link rel="icon" href={site.logo} />
    {precarga && <link rel="preload" as="image" href={precarga} fetchpriority="high" />}
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body class="web" data-tema={idTema} style={vars}>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N4MJ69PR" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <header class="cabecera">
      <div class="contenedor">
        <a class="marca" href="/">
          <img src={site.logo_web} alt={`Logo de ${site.nombre}`} width="44" height="44" />
          <span>{site.nombre_logo ?? site.nombre}</span>
        </a>
        <button class="menu-boton" type="button" aria-expanded="false" aria-controls="menu-principal">
          <span class="menu-icono" aria-hidden="true"></span>Menú
        </button>
        <nav class="menu" id="menu-principal" aria-label="Principal">
          <a href="/" aria-current={pagina.tipo === 'portada' ? 'page' : undefined}>Clínica dental</a>
          <a href="/odontologos-santa-fe/">Odontólogos</a>
          <a href={ruta('implantes-dentales-santa-fe')}>Implantes dentales</a>
          <details class="desplegable">
            <summary>Ortodoncia</summary>
            <ul class="panel">
              {tratamientos.filter((t) => MENU_ORTODONCIA.includes(t.slug)).map((t) => <li><a href={ruta(t.slug)}>{etiqueta(t)}</a></li>)}
            </ul>
          </details>
          <details class="desplegable">
            <summary>Estética dental</summary>
            <ul class="panel">
              {tratamientos.filter((t) => MENU_ESTETICA.includes(t.slug)).map((t) => <li><a href={ruta(t.slug)}>{etiqueta(t)}</a></li>)}
            </ul>
          </details>
          <a href="/obras-sociales/">Obras sociales</a>
          <details class="desplegable">
            <summary>Otros tratamientos</summary>
            <ul class="panel">
              {tratamientos.filter((t) => !MENU_SUELTOS.includes(t.slug)).map((t) => <li><a href={ruta(t.slug)}>{etiqueta(t)}</a></li>)}
              <li class="todos"><a href="/tratamientos/">Todos los tratamientos →</a></li>
            </ul>
          </details>
          <a href="/contacto/">Contacto</a>
          <a class="boton" href="/contacto/">Pedir turno</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    {pagina.tipo !== '404' && pagina.tipo !== 'turnos' && pagina.tipo !== 'portada' && (
      <aside class="franja-turno" aria-label="Turnos">
        <div class="contenedor">
          <div>
            <p class="antetitulo">{site.antetitulo}</p>
            <p class="titulo-franja">Turnos en Santa Fe</p>
            <p>Por WhatsApp, por teléfono o con el formulario de contacto.</p>
          </div>
          <div class="botones">
            {site.sedes.map((s) => <a class="boton" href={enlaceTurno(s)}>Pedir turno →</a>)}
          </div>
        </div>
      </aside>
    )}

    <footer class="pie">
      <div class="contenedor">
        {site.sedes.map((s) => (
          <div>
            <p class="pie-titulo"><a href="/contacto/">{site.nombre} · {s.ciudad}</a></p>
            <p>{s.direccion}<br />{etiquetaTelefono(s)}: {telefonoDe(s)}<br />{s.horario}</p>
          </div>
        ))}
        <div>
          <p class="pie-titulo"><a href="/tratamientos/">Tratamientos dentales</a></p>
          <ul class="pie-lista">
            {tratamientos.map((t) => <li><a href={ruta(t.slug)}>{etiqueta(t)}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="pie-titulo">{site.nombre}</p>
          <p>
            <a href="/tratamientos/">Todos los tratamientos</a><br />
            <a href="/obras-sociales/">Obras sociales</a><br />
            <a href="/odontologos-santa-fe/">Odontólogos</a>
          </p>
        </div>
      </div>
      <div class="contenedor pie-legal">
        <img src={site.logo_web} alt="" role="presentation" width="40" height="40" loading="lazy" />
        <p><a href="/privacidad/">Privacidad</a> · <a href="/terminos/">Términos</a></p>
      </div>
    </footer>

    {/* Botón flotante del móvil: abre WhatsApp si hay número (Yama, 2026-11-15). */}
    <a class="boton boton-turno" href={enlaceTurno(site.sedes[0])} aria-label={site.sedes[0]?.whatsapp ? 'Pedir turno por WhatsApp' : 'Pedir turno'}>
      {site.sedes[0]?.whatsapp && <svg class="icono-wa" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.6-.3z"/></svg>}
      Pedir turno
    </a>
    <script>
      // Menú: abrir un desplegable cierra el otro; clic fuera o Esc los cierra.
      const desplegables = [...document.querySelectorAll('.menu details')];
      desplegables.forEach((d) => d.addEventListener('toggle', () => {
        if (d.open) desplegables.forEach((o) => { if (o !== d) o.open = false; });
      }));
      document.addEventListener('click', (e) => {
        desplegables.forEach((d) => { if (!d.contains(e.target)) d.open = false; });
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') desplegables.forEach((d) => { d.open = false; });
      });
      // Móvil: el menú se pliega tras el botón «Menú» (análisis SEO 2026-11-15: abierto ocupaba 227 px fijos).
      // Sin JavaScript no se pliega (la clase "js" la pone el <head>): los enlaces siempre quedan visibles.
      const boton = document.querySelector('.menu-boton');
      const menu = document.getElementById('menu-principal');
      boton?.addEventListener('click', () => {
        const abierto = menu.classList.toggle('abierto');
        boton.setAttribute('aria-expanded', String(abierto));
      });
    </script>
  </body>
</html>
